# Public values only: everything VITE_* ends up in the browser bundle. Never put secrets here.
VITE_DB_PROVIDER=sheets
VITE_GOOGLE_CLIENT_ID=
VITE_BASE_PATH=/

# sheets
VITE_SHEETS_API_URL=
VITE_IDENTITY_API_URL=
VITE_EXPENSE_API_URL=

# supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# firebase (web config from the Firebase console; VITE_FIREBASE_FUNCTIONS_REGION is optional)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FUNCTIONS_REGION=
